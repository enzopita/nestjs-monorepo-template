    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.2",
    "auth": "^1.7.6",
    "drizzle-kit": "1.0.0-rc.4",
    "source-map-support": "^0.5.21",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
