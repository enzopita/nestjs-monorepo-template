    "@nestjs/swagger": "^12.0.2",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "better-auth": "^1.7.6",
    "drizzle-orm": "1.0.0-rc.4",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.5"
  },
