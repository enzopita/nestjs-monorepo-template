  "type": "module",
  "scripts": {
    "auth:generate": "auth generate --config src/auth/auth.cli.ts --output src/auth/auth.schema.ts --yes",
    "build": "nest build",
    "check-types": "node node_modules/typescript7/bin/tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "dev": "nest start --watch",
    "lint": "oxlint src/ test/",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.6",
    "@fastify/static": "^10.1.4",
    "@nestjs/common": "^12.0.1",
