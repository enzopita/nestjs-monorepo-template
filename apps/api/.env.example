NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/api
SWAGGER_ENABLED=true
# Observe reports only when credentials are set (https://observe.nestjs.com)
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
OBSERVE_SERVICE_ID=api

# Better Auth (generate a secret with: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
